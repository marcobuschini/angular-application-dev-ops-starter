{
  "name": "adventurers-notebook",
  "version": "0.0.0",
  "main": "main.js",
  "build": {
    "appId": "marcobuschini.test.app",
    "mac": {
      "category": "your.app.category.type"
    }
  },
  "engines": {
    "node": "~22.*",
    "npm": "~10.*"
  },
  "scripts": {
    "postinstall": "npx husky install",
    "ng": "npx ng",
    "start": "npx ng serve",
    "build": "npx ng build",
    "build:prod": "npx ng build --configuration production",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run --coverage",
    "lint": "npx ng lint && qlty check --all && qlty smells --all && qlty metrics --all",
    "cy:open": "npx cypress open",
    "cy:run": "npx cypress run",
    "e2e": "npx ng e2e",
    "e2e:ci": "npx start-server-and-test start http://localhost:4200 cy:run",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.1",
    "@angular/common": "^21.2.1",
    "@angular/compiler": "^21.2.1",
    "@angular/core": "^21.2.1",
    "@angular/forms": "^21.2.1",
    "@angular/material": "^21.2.1",
    "@angular/platform-browser": "^21.2.1",
    "@angular/platform-browser-dynamic": "^21.2.1",
    "@angular/router": "^21.2.1",
    "ngx-logger": "^5.0.12",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "19.3.0",
    "@angular-eslint/eslint-plugin": "^19.3.0",
    "@angular-eslint/eslint-plugin-template": "19.3.0",
    "@angular-eslint/schematics": "19.3.0",
    "@angular-eslint/template-parser": "19.3.0",
    "@angular/build": "^21.2.1",
    "@angular/cdk": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.1",
    "@angular/language-service": "^21.2.1",
    "@compodoc/compodoc": "^1.1.26",
    "@cypress/webpack-preprocessor": "6.0.4",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "commitizen": "^4.3.1",
    "coveralls": "^3.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "^50.7.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "husky": "^9.1.7",
    "jsdom": "^23.2.0",
    "ngx-translate-testing": "^7.0.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.2.2",
    "ts-loader": "9.5.2",
    "ts-node": "~10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "webpack": "^5.91.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
